# powered by Rush , mod by webpad

on boot
    start webpadservice

on property:ro.debuggable=0
    start webpadservice

on property:ro.debuggable=1
    start webpadservice

service webpadservice /system/bin/webpad
    class main
    user root
    group root shell log readproc
    disabled
    oneshot
    seclabel u:r:adbd:s0
