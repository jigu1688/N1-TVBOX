<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_panel"
    android:gravity="center_vertical"
    android:paddingLeft="28dp"
    android:paddingRight="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Left Block: Auto TextClock & Date -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- Ultra Mega TextClock 116sp -->
        <TextClock
            android:id="@+id/tv_cw_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:format12Hour="HH:mm"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="116sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-light"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="8"
            android:shadowRadius="20" />

        <!-- Date, Weekday & Lunar (22sp) -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:gravity="center_vertical">

            <TextClock
                android:id="@+id/tv_cw_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="M月d日 EEEE"
                android:format12Hour="M月d日 EEEE"
                android:textColor="#BAE6FD"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cw_lunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="·  农历七月十八"
                android:textColor="#94A3B8"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- Right Block: 2-Row Huge Weather & City (Clickable) -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end">

        <!-- Row 1: Weather Display (34sp) -->
        <TextView
            android:id="@+id/tv_cw_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_capsule_accent"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="☀️ 晴 26°C"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Row 2: City Badge (20sp) -->
        <TextView
            android:id="@+id/tv_cw_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_capsule"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="📍 北京"
            android:textColor="#BAE6FD"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
