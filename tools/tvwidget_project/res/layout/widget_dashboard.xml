<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_panel"
    android:paddingLeft="28dp"
    android:paddingRight="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Top Block: Ultra Mega TextClock & Huge Weather -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- Left: Auto TextClock & Date -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- Ultra Mega TextClock 116sp -->
            <TextClock
                android:id="@+id/tv_widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="HH:mm"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="116sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="8"
                android:shadowRadius="20" />

            <!-- Date & Lunar (22sp) -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:gravity="center_vertical">

                <TextClock
                    android:id="@+id/tv_widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format24Hour="M月d日 EEEE"
                    android:format12Hour="M月d日 EEEE"
                    android:textColor="#BAE6FD"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_lunar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:text="·  农历七月十八"
                    android:textColor="#94A3B8"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Right: 2-Row Huge Weather & City -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end">

            <!-- Row 1: Weather & Temp Huge Capsule (34sp) -->
            <TextView
                android:id="@+id/tv_widget_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_capsule_accent"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="☀️ 晴 26°C"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Row 2: City Location Badge (20sp) -->
            <TextView
                android:id="@+id/tv_widget_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass_capsule"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="📍 北京"
                android:textColor="#BAE6FD"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Elastic Middle Spacer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Row: 4 Single-line Hardware Badges (No wrapping) -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- CPU Temp -->
        <TextView
            android:id="@+id/tv_widget_temp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glass_capsule_warm"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="🌡️ CPU 48°C"
            android:textColor="#FDE68A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- RAM -->
        <TextView
            android:id="@+id/tv_widget_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/glass_capsule"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="⚡ 内存 28%"
            android:textColor="#A7F3D0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Storage -->
        <TextView
            android:id="@+id/tv_widget_storage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/glass_capsule"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="📦 闪存 4.3G"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- IP Address -->
        <TextView
            android:id="@+id/tv_widget_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:layout_marginLeft="8dp"
            android:background="@drawable/glass_capsule"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="🌐 192.168.31.114"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
